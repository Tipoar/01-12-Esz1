<Window x:Class="Cukraszdawpf.wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cukrászda"
        Height="450"
        Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="111*"/>
            <ColumnDefinition Width="589*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.ColumnSpan="2">

            <Menu DockPanel.Dock="Top">

                <MenuItem Header="Fájl">
                    <MenuItem Header="Betöltés"
                              Click="Betoltes_Click"/>
                </MenuItem>

                <MenuItem Header="Sütemények"
                          Name="menuSutemenyek"
                          IsEnabled="False"
                          Click="Sutemenyek_Click"/>

                <MenuItem Header="Névjegy"
                          Click="Nevjegy_Click"/>

            </Menu>

            <Image Name="imgCukraszda"
                   Width="400"
                   Height="300"
                   Stretch="Uniform" Source="/OIP.png"/>

        </DockPanel>
    </Grid>

</Window>
