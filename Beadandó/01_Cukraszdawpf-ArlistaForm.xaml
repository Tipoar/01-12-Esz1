<Window x:Class="Cukraszdawpf.wpf.ArlistaForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sutemenyek arlistaja"
        Height="450"
        Width="500"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">

        <TextBlock Text="SUTEMENYEK ARLISTAJA"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <CheckBox Name="chkSomloi"
                  Content="Somloi galuska - 800 Ft"/>

        <TextBox Name="txtSomloi"
                 Text="0"
                 Margin="0,5,0,10"/>

        <CheckBox Name="chkRepa"
                  Content="Repatorta - 850 Ft"/>

        <TextBox Name="txtRepa"
                 Text="0"
                 Margin="0,5,0,10"/>

        <CheckBox Name="chkCsoki"
                  Content="Csokitorta - 750 Ft"/>

        <TextBox Name="txtCsoki"
                 Text="0"
                 Margin="0,5,0,10"/>

        <CheckBox Name="chkMarcipan"
                  Content="Marcipanos alom - 900 Ft"/>

        <TextBox Name="txtMarcipan"
                 Text="0"
                 Margin="0,5,0,10"/>

        <Button Name="btnRendel"
                Content="RENDEL"
                Height="35"
                Margin="0,15,0,0"
                Click="Rendel_Click"
                MouseRightButtonDown="Rendel_Jobb_Click"/>

    </StackPanel>

</Window>
